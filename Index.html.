<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#00a86b">
    <title>Arcruise</title>
    <link rel="manifest" href="manifest.json">
    <style>
        :root {
            --bg: #f0f2f5; --card-bg: #ffffff; --primary: #00a86b; --primary-light: #00c880;
            --text: #1a1a1a; --text-muted: #666; --border: #e0e0e0; --green: #00a86b;
            --green-light: #e6fff3; --red: #c62828; --orange: #ff9800; --blue: #1565c0; --purple: #7e57c2;
            --shadow: 0 2px 12px rgba(0,0,0,0.08);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); }
   .app { max-width: 430px; margin: 0 auto; background: var(--bg); min-height: 100vh; }

   .auth-screen { position: fixed; inset: 0; background: linear-gradient(135deg, #00a86b 0%, #00d27a 100%); z-index: 1000; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; }
   .auth-screen.hidden { display: none!important; }
   .auth-logo { width: 90px; height: 90px; background: white; border-radius: 24px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.15); }
   .auth-logo span { font-size: 48px; font-weight: 800; color: var(--primary); } /* NAIRA LOGO */
   .auth-title { color: white; font-size: 32px; font-weight: 800; margin-bottom: 30px; }
   .auth-input { width: 100%; padding: 16px; border: none; border-radius: 14px; background: rgba(255,255,255,0.2); color: white; font-size: 16px; margin-bottom: 12px; }
   .auth-btn { width: 100%; padding: 16px; border: none; border-radius: 14px; background: white; color: var(--primary); font-size: 16px; font-weight: 700; cursor: pointer; }

   .header { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%); padding: 18px 16px; color: white; }
   .balance-card { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%); border-radius: 20px; padding: 24px; margin: -12px 16px 20px; color: white; box-shadow: var(--shadow); }
   .balance-amount { font-size: 36px; font-weight: 800; margin: 8px 0; }
   .quick-actions { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 18px; }
   .qa-btn { background: rgba(255,255,255,0.25); border: none; border-radius: 14px; padding: 14px 8px; color: white; font-weight: 600; cursor: pointer; }

   .referral-box { background: var(--card-bg); border-radius: 18px; padding: 20px; margin: 0 16px 20px; border: 1px solid var(--border); }
   .progress-bar { background: var(--bg); border-radius: 10px; height: 10px; margin: 12px 0; }
   .progress-fill { background: linear-gradient(90deg, var(--primary), var(--primary-light)); height: 100%; border-radius: 10px; }
   .referral-link { background: var(--green-light); border: 2px dashed var(--primary); padding: 14px; border-radius: 12px; display: flex; justify-content: space-between; }
   .copy-btn { background: var(--primary); color: white; border: none; padding: 8px 18px; border-radius: 10px; font-weight: 600; cursor: pointer; }

   .task-card { background: var(--card-bg); border-radius: 16px; padding: 16px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border); }
   .task-left { display: flex; gap: 12px; align-items: center; }
   .task-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
   .task-icon.green { background: var(--green-light); }
   .task-icon.purple { background: #f3e5f5; }
   .task-icon.orange { background: #fff3e0; }
   .claim-btn { background: var(--primary); color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 700; cursor: pointer; }
   .claim-btn:disabled { background: var(--text-muted); cursor: not-allowed; }

   .ad-box { background: var(--card-bg); border-radius: 16px; padding: 16px; margin: 0 16px 20px; text-align: center; border: 1px dashed var(--border); }

   .user-card { background: var(--card-bg); border-radius: 14px; padding: 16px; margin-bottom: 12px; border: 1px solid var(--border); }
   .user-card button { background: var(--green); color: white; border: none; padding: 8px 14px; border-radius: 8px; font-size: 12px; cursor: pointer; font-weight: 600; margin-right:8px; }
   .badge { padding: 5px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
   .badge.success { background: var(--green-light); color: var(--green); }
   .badge.pending { background: var(--blue); color: white; }

   .tx-list { display: flex; flex-direction: column; gap: 10px; padding: 0 16px; }
   .tx-item { background: var(--card-bg); border-radius: 14px; padding: 16px; display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--border); }
   .tx-amount.positive { color: var(--green); font-weight: 700; }
   .tx-amount.negative { color: var(--red); font-weight: 700; }

   .bottom-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 430px; background: var(--card-bg); border-top: 1px solid var(--border); display: grid; grid-template-columns: repeat(5, 1fr); padding: 8px 0 24px; }
   .nav-item { display: flex; flex-direction: column; align-items: center; cursor: pointer; }
   .nav-item.active.nav-label { color: var(--primary); font-weight: 700; }
   .nav-label { font-size: 11px; color: var(--text-muted); }

   .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.55); display: flex; align-items: flex-end; justify-content: center; z-index: 200; opacity: 0; pointer-events: none; transition: 0.3s; }
   .modal-overlay.active { opacity: 1; pointer-events: all; }
   .modal-sheet { background: white; border-radius: 24px 24px 0 0; padding: 24px; width: 100%; max-width: 430px; max-height: 85vh; overflow-y: auto; }
   .modal-input { width: 100%; padding: 15px; border: 1.5px solid var(--border); border-radius: 12px; margin-bottom: 12px; }
   .modal-btn { width: 100%; padding: 16px; border-radius: 12px; border: none; font-size: 16px; font-weight: 700; background: var(--primary); color: white; cursor: pointer; }
   .bank-box { background: var(--green-light); border: 2px dashed var(--primary); border-radius: 14px; padding: 18px; margin-bottom: 14px; }
   .alert-box { background: #fff3e0; border: 1.5px solid var(--orange); border-radius: 14px; padding: 16px; margin-bottom: 14px; color: #e65100; }
   .toast { background: var(--card-bg); border-radius: 14px; padding: 14px 22px; box-shadow: 0 8px 30px rgba(0,0,0,0.2); position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 300; font-weight: 600; }

   .hidden { display: none!important; }
   .tab-content { display: none; }
   .tab-content.active { display: block; padding-bottom: 110px; }
    </style>
</head>
<body>

<!-- AUTH SCREEN -->
<div class="auth-screen" id="authScreen">
    <div class="auth-logo"><span>₦</span></div> <!-- NAIRA LOGO HERE -->
    <div class="auth-title">Arcruise</div>
    <form class="auth-form" onsubmit="handleAuth(event)">
        <input type="email" id="loginEmail" class="auth-input" placeholder="Email address" required>
        <input type="password" id="loginPassword" class="auth-input" placeholder="Password" required>
        <button type="submit" class="auth-btn">Login / Sign Up</button>
    </form>
</div>

<!-- USER APP -->
<div class="app hidden" id="mainApp">
    <div class="header">
        <div style="font-size:18px;font-weight:700">Hi, <span id="userName">User</span> 👋</div>
    </div>

    <div id="tab-home" class="tab-content active">
        <div class="balance-card">
            <div>Available Balance</div>
            <div class="balance-amount">₦<span id="totalBalance">0.00</span></div>
            <div class="quick-actions">
                <button class="qa-btn" onclick="openModal('Recharge')">⬇️<span>Fund</span></button>
                <button class="qa-btn" id="withdrawBtn" onclick="openModal('Withdrawal')">⬆️<span>Withdraw</span></button>
                <button class="qa-btn" onclick="openModal('Referral')">👥<span>Invite</span></button>
            </div>
        </div>

        <div class="referral-box">
            <div style="font-weight:700">Earn ₦100 Per Referral</div>
            <div style="font-size:13px;color:var(--text-muted)">Invite 20 people to unlock withdrawal</div>
            <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
            <div style="font-size:13px"><b id="refCount">0</b>/20 Referrals | Earned: <b>₦<span id="refEarned">0</span></b></div>
            <div class="referral-link">
                <span id="referralLink" style="font-size:12px">arcruise.github.io/Twosh-?ref=user</span>
                <button class="copy-btn" onclick="copyReferral()">Copy</button>
            </div>
        </div>

        <div class="ad-box">
            <small style="color:var(--text-muted)">Sponsored</small>
            <div style="margin-top:8px">Your Ad Here - 320x100</div>
        </div>

        <div style="padding:0 16px">
            <h3 style="margin-bottom:12px">Earn Daily</h3>
            <div class="task-card">
                <div class="task-left">
                    <div class="task-icon green">🎁</div>
                    <div><b>Daily Bonus</b><br><small style="color:var(--text-muted)">Claim ₦20 every 24hrs</small></div>
                </div>
                <button id="dailyBtn" class="claim-btn" onclick="claimDaily()">Claim</button>
            </div>
            <div class="task-card">
                <div class="task-left">
                    <div class="task-icon purple">📺</div>
                    <div><b>Watch Ad</b><br><small style="color:var(--text-muted)">Earn ₦10 - 5 times daily</small></div>
                </div>
                <button id="adBtn" class="claim-btn" onclick="watchAd()">Watch</button>
            </div>
            <div class="task-card">
                <div class="task-left">
                    <div class="task-icon orange">🎡</div>
                    <div><b>Spin Wheel</b><br><small style="color:var(--text-muted)">Win ₦5 - ₦100 daily</small></div>
                </div>
                <button id="spinBtn" class="claim-btn" onclick="spinWheel()">Spin</button>
            </div>
        </div>
    </div>

    <div id="tab-history" class="tab-content">
        <div style="padding:16px"><h3>Transaction History</h3></div>
        <div id="txList" class="tx-list"></div>
    </div>

    <div class="bottom-nav">
        <div class="nav-item active" onclick="switchTab('home', this)"><div class="nav-label">Home</div></div>
        <div class="nav-item" onclick="switchTab('history', this)"><div class="nav-label">History</div></div>
        <div class="nav-item" onclick="openModal('Support')"><div class="nav-label">Support</div></div>
        <div class="nav-item" onclick="openModal('Profile')"><div class="nav-label">Profile</div></div>
        <div class="nav-item" onclick="openModal('Install')"><div class="nav-label">Install</div></div>
    </div>
</div>

<!-- ADMIN APP -->
<div class="app hidden" id="adminApp">
    <div class="header" style="background:var(--blue)">
        <div style="font-size:18px;font-weight:700">Admin Panel</div>
        <button onclick="logout()" style="background:white;color:var(--blue);border:none;padding:8px 14px;border-radius:10px">Logout</button>
    </div>
    <div style="padding:20px 16px">
        <h3>Pending Fundings <span id="fundingCount" class="badge pending">0</span></h3>
        <div id="adminFundingList"></div>
        <h3 style="margin-top:20px">Pending Withdrawals</h3>
        <div id="adminWithdrawList"></div>
        <h3 style="margin-top:20px">All Users</h3>
        <div id="adminUserList"></div>
    </div>
</div>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModal()">
    <div class="modal-sheet" onclick="event.stopPropagation()">
        <h3 id="modalTitle"></h3>
        <div id="modalContent" style="margin:18px 0"></div>
    </div>
</div>
<div id="toastContainer"></div>

<script>
    let balance = 0, refCount = 0, refEarned = 0, currentUser = "";
    const WITHDRAWAL_LIMIT = 20;
    const ADMIN_WHATSAPP = "2349060086120"; 
    let users = JSON.parse(localStorage.getItem('arcruise_users_final')) || [];

    function saveUsers() { localStorage.setItem('arcruise_users_final', JSON.stringify(users)); }

    function handleAuth(e) {
        e.preventDefault();
        let email = document.getElementById('loginEmail').value;
        let pass = document.getElementById('loginPassword').value;

        if(email === "admin@arcruise.com" && pass === "1234") {
            document.getElementById('authScreen').classList.add('hidden');
            document.getElementById('adminApp').classList.remove('hidden');
            loadAdmin(); return;
        }

        currentUser = email;
        let user = users.find(u => u.email === email);
        if(!user) {
            user = {email, balance:0, refCount:0, refEarned:0, transactions:[], withdrawals:[], fundings:[], lastDaily:0, adCount:0, adDate:0, lastSpin:0};
            users.push(user);
        }
        balance = user.balance; refCount = user.refCount; refEarned = user.refEarned;
        document.getElementById('userName').innerText = email.split('@')[0];
        document.getElementById('referralLink').innerText = `arcruise.github.io/Twosh-?ref=${email.split('@')[0]}`;
        document.getElementById('authScreen').classList.add('hidden');
        document.getElementById('mainApp').classList.remove('hidden');
        updateUI(); loadTransactions(); checkTaskButtons();
    }

    function checkTaskButtons() {
        let u = users.find(x=>x.email===currentUser);
        let now = Date.now();
        let dailyBtn = document.getElementById('dailyBtn');
        if(now - u.lastDaily < 86400000) {
            let hoursLeft = Math.ceil((86400000 - (now - u.lastDaily))/3600000);
            dailyBtn.innerText = hoursLeft + "h";
            dailyBtn.disabled = true;
        } else { dailyBtn.innerText = "Claim"; dailyBtn.disabled = false; }

        if(u.adDate!== new Date().toDateString()) { u.adCount = 0; u.adDate = new Date().toDateString(); }
        let adBtn = document.getElementById('adBtn');
        if(u.adCount >= 5) { adBtn.innerText = "0/5"; adBtn.disabled = true; }
        else { adBtn.innerText = `${5-u.adCount}/5`; adBtn.disabled = false; }

        let spinBtn = document.getElementById('spinBtn');
        if(now - u.lastSpin < 86400000) {
            let hoursLeft = Math.ceil((86400000 - (now - u.lastSpin))/3600000);
            spinBtn.innerText = hoursLeft + "h";
            spinBtn.disabled = true;
        } else { spinBtn.innerText = "Spin"; spinBtn.disabled = false; }
    }

    function claimDaily() {
        let u = users.find(x=>x.email===currentUser);
        u.lastDaily = Date.now();
        balance += 20; u.balance = balance;
        addTransaction("Daily Bonus", 20, 'positive');
        saveUsers(); updateUI(); checkTaskButtons();
        showToast("You claimed ₦20 Daily Bonus!");
    }

    function watchAd() {
        let u = users.find(x=>x.email===currentUser);
        if(u.adCount >= 5) return;
        u.adCount++;
        balance += 10; u.balance = balance;
        addTransaction("Watch Ad", 10, 'positive');
        saveUsers(); updateUI(); checkTaskButtons();
        showToast("You earned ₦10 from watching ad!");
    }

    function spinWheel() {
        let u = users.find(x=>x.email===currentUser);
        u.lastSpin = Date.now();
        let prizes = [5, 10, 20, 50, 100];
        let win = prizes[Math.floor(Math.random() * prizes.length)];
        balance += win; u.balance = balance;
        addTransaction("Spin Wheel", win, 'positive');
        saveUsers(); updateUI(); checkTaskButtons();
        showToast(`You won ₦${win} from Spin!`);
    }

    function loadAdmin() {
        let fundingHtml = ""; let count = 0;
        users.forEach(u => {
            u.fundings.forEach(f => {
                if(f.status === 'pending') {
                    count++;
                    fundingHtml += `<div class="user-card"><b>${u.email}</b><br><small>Paid: ₦${f.amount}<br>Proof: ${f.proof}<br>Time: ${f.time}</small><br>
                    <button onclick="approveFunding('${u.email}',${f.amount},'${f.id}')">Approve & Fund</button>
                    <button onclick="rejectFunding('${u.email}','${f.id}')" style="background:var(--red)">Reject</button></div>`;
                }
            });
        });
        document.getElementById('adminFundingList').innerHTML = fundingHtml || "<div style='color:var(--text-muted)'>No pending fundings</div>";
        document.getElementById('fundingCount').innerText = count;
    }

    function approveFunding(email, amount, id) {
        let u = users.find(x=>x.email===email);
        u.balance += parseInt(amount);
        let f = u.fundings.find(x=>x.id===id);
        f.status = 'approved';
        u.transactions.unshift({title:`Wallet Funding`, amt:amount, type:'positive', date:new Date().toLocaleString()});
        saveUsers(); loadAdmin(); showToast(`₦${amount} funded to ${email}`);
    }
    function rejectFunding(email, id) {
        let u = users.find(x=>x.email===email);
        let f = u.fundings.find(x=>x.id===id);
        f.status = 'rejected';
        saveUsers(); loadAdmin(); showToast(`Funding rejected`);
    }

    function switchTab(tab, element) {
        document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        document.getElementById('tab-' + tab).classList.add('active');
        element.classList.add('active');
    }

    function updateUI() {
        let percent = (refCount / WITHDRAWAL_LIMIT) * 100;
        document.getElementById('progressFill').style.width = percent + '%';
        document.getElementById('refCount').innerText = refCount;
        document.getElementById('refEarned').innerText = refEarned;
        document.getElementById('totalBalance').innerText = balance.toFixed(2);
        document.getElementById('withdrawBtn').style.opacity = refCount >= WITHDRAWAL_LIMIT? '1' : '0.5';
    }

    function openModal(title) {
        let content = "";
        if(title === "Recharge") {
            content = `<div class="bank-box"><b>🏦 Pay to this OPay account:</b><br><br><b>Bank:</b> OPay Digital Services<br><b>Account No:</b> 9060086120<br><b>Account Name:</b> HENSHAW DESTINY OKON<br></div>
            <input type="number" id="rechargeAmount" class="modal-input" placeholder="Amount you transferred">
            <input type="text" id="proof" class="modal-input" placeholder="Transaction ID / Proof">
            <button class="modal-btn" onclick="submitRecharge()">Submit for Approval</button>`;
        }
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalContent').innerHTML = content;
        document.getElementById('modalOverlay').classList.add('active');
    }

    function submitRecharge() {
        let amt = document.getElementById('rechargeAmount').value;
        let proof = document.getElementById('proof').value;
        if(!amt ||!proof) return showToast('Enter amount and proof');
        let u = users.find(x=>x.email===currentUser);
        let id = Date.now();
        u.fundings.push({id:id, amount:amt, proof:proof, status:'pending', time:new Date().toLocaleString()});
        addTransaction(`Funding Request`, amt, 'positive');
        saveUsers();
        let message = `🚨 NEW FUNDING REQUEST 🚨%0A%0AUser: ${currentUser}%0AAmount: ₦${amt}%0AProof: ${proof}%0ATime: ${new Date().toLocaleString()}`;
        window.open(`https://wa.me/${ADMIN_WHATSAPP}?text=${message}`, '_blank');
        showToast(`Funding request sent. Check WhatsApp for alert`);
        closeModal();
    }

    function copyReferral() {
        navigator.clipboard.writeText(document.getElementById('referralLink').innerText);
        showToast('Copied!');
    }
    function closeModal() { document.getElementById('modalOverlay').classList.remove('active'); }
    function showToast(msg) {
        const toast = document.createElement('div'); toast.className = 'toast'; toast.innerText = msg;
        document.getElementById('toastContainer').appendChild(toast); setTimeout(() => toast.remove(), 3000);
    }
    function addTransaction(title, amt, type) {
        let u = users.find(x=>x.email===currentUser);
        u.transactions.unshift({title, amt, type, date: new Date().toLocaleString()});
        saveUsers();
    }
    function loadTransactions() {
        let u = users.find(x=>x.email===currentUser);
        document.getElementById('txList').innerHTML = "";
        u.transactions.forEach(t=>{
            const tx = document.createElement('div');
            tx.className = 'tx-item';
            tx.innerHTML = `<div><b>${t.title}</b><br><small style="color:var(--text-muted)">${t.date}</small></div><div class="tx-amount ${t.type}">${t.type==='positive'?'+':'-'}₦${t.amt}</div>`;
            document.getElementById('txList').appendChild(tx);
        })
    }
    function logout() { location.reload(); }
</script>

</body>
</html>
